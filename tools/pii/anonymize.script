#!/bin/bash
#SBATCH --job-name=anonymize_pii
#SBATCH --output=/data/hartwigd/pii/results/anonymize_%j.log
#SBATCH --error=/data/hartwigd/pii/results/anonymize_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=24:00:00

# Usage:
#   sbatch anonymize.script <pii_results.csv>                 # anonymize everything
#   sbatch anonymize.script <pii_results.csv> <types-to-keep> # leave these types unchanged
#
# <types-to-keep> is a comma-separated list (no spaces). Use Presidio entity
# types, or these shortcuts:
#     names          -> PERSON
#     locations      -> LOCATION       (cities, states, etc.; NOT street addresses)
#     dates          -> DATE_TIME      (NOT dates of birth)
#     organizations  -> ORGANIZATION
#     keep_names     -> PERSON         (same as "names"; kept for older commands)
#
# Examples:
#   sbatch anonymize.script /data/hartwigd/pii/results/pii_results_123.csv names
#   sbatch anonymize.script /data/hartwigd/pii/results/pii_results_123.csv names,locations,dates,organizations
#   sbatch anonymize.script /data/hartwigd/pii/results/pii_results_123.csv PERSON,ZIP_CODE
#
# Output goes to /data/hartwigd/pii/anonymize when nothing is kept, otherwise
# to /data/hartwigd/pii/anonymize_keep_<types>, so runs with different
# settings never overwrite each other.
PII_RESULTS_CSV="${1:?Usage: sbatch anonymize.script <path-to-pii_results_csv> [types-to-keep]}"
KEEP_ARG="${2:-}"
if [ $# -gt 2 ]; then
    echo "ERROR: too many arguments. Write the types to keep as one comma-separated" >&2
    echo "       list with no spaces, e.g. names,locations,dates,organizations" >&2
    exit 1
fi

# Stop execution if any step fails
set -e

echo "Job started at: $(date)"

# Create the log/results directory if it does not exist.
# NOTE: this needs to exist *before* sbatch is run, since SLURM opens the
# --output/--error log files at job start, before this line ever executes.
mkdir -p /data/hartwigd/pii/results

# Activate your virtual environment
VENV="/data/hartwigd/pve"
source "$VENV/bin/activate"

# Define input/output paths
INPUT_DIR="/data/hartwigd/pii"

# Turn the second argument into a list of entity types to keep.
KEEP_TYPES=""
if [ -n "$KEEP_ARG" ]; then
    for item in ${KEEP_ARG//,/ }; do
        case "$(echo "$item" | tr '[:upper:]' '[:lower:]')" in
            keep_names|names|name|person)            type="PERSON" ;;
            locations|location)                      type="LOCATION" ;;
            dates|date|datetime|date_time|times)     type="DATE_TIME" ;;
            organizations|organization|orgs|org)     type="ORGANIZATION" ;;
            *)
                type="$(echo "$item" | tr '[:lower:]' '[:upper:]')"
                if ! [[ "$type" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
                    echo "ERROR: '$item' is not a valid entity type." >&2
                    echo "       Use a comma-separated list with no spaces, e.g. names,locations,dates,organizations" >&2
                    exit 1
                fi ;;
        esac
        KEEP_TYPES="$KEEP_TYPES $type"
    done
    # Sort and de-duplicate so the same settings always map to the same folder.
    KEEP_TYPES="$(echo $KEEP_TYPES | tr ' ' '\n' | sort -u | tr '\n' ',' | sed 's/,$//')"
fi

if [ -z "$KEEP_TYPES" ]; then
    OUTPUT_DIR="/data/hartwigd/pii/anonymize"
    KEEP_OPTION=()
    echo "Keeping: nothing (all detected PII is anonymized)"
else
    if [ "$KEEP_TYPES" = "PERSON" ]; then
        OUTPUT_DIR="/data/hartwigd/pii/anonymize_keep_names"   # same folder as before
    else
        OUTPUT_DIR="/data/hartwigd/pii/anonymize_keep_$(echo "$KEEP_TYPES" | tr '[:upper:]' '[:lower:]' | tr ',' '-')"
    fi
    KEEP_OPTION=(--keep_entities "$KEEP_TYPES")
    echo "Keeping unchanged: $KEEP_TYPES"
fi
mkdir -p "$OUTPUT_DIR"
echo "Output folder: $OUTPUT_DIR"

# The pipeline scripts live in the directory sbatch was run from.
SCRIPT_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
cd "$SCRIPT_DIR"

# ---------------------------------------------------------------------------
# Preflight checks: fail fast, with a clear message, before any work starts.
# ---------------------------------------------------------------------------

# Which Python is this job using? (Compare with the same line in the analyze log.)
echo "Python: $(command -v python)"
python -c "import sys; print('Python executable:', sys.executable); print('Python version:', sys.version.split()[0])"

if [ ! -f "$SCRIPT_DIR/anonymize_pipeline.py" ]; then
    echo "ERROR: anonymize_pipeline.py not found in $SCRIPT_DIR." >&2
    echo "       Run sbatch from the folder that contains the pipeline scripts." >&2
    exit 1
fi

if [ ! -f "$PII_RESULTS_CSV" ]; then
    echo "ERROR: results CSV not found: $PII_RESULTS_CSV" >&2
    exit 1
fi

# Check every package the anonymizer imports is installed in this environment.
python - "$VENV" <<'EOF'
import importlib, sys
needed = {                      # import name -> pip package name
    "pandas": "pandas",
    "presidio_analyzer": "presidio-analyzer",
    "presidio_anonymizer": "presidio-anonymizer",
    "pdfminer": "pdfminer.six",
    "pytesseract": "pytesseract",
    "PIL": "pillow",
}
missing = []
for module, package in needed.items():
    try:
        importlib.import_module(module)
    except ImportError:
        missing.append(package)
if missing:
    venv = sys.argv[1]
    print("ERROR: these packages are not installed in the environment at " + venv + ":",
          ", ".join(missing), file=sys.stderr)
    print("Install them from a login node with:", file=sys.stderr)
    print(f"    source {venv}/bin/activate", file=sys.stderr)
    print(f"    python -m pip install {' '.join(missing)}", file=sys.stderr)
    sys.exit(1)
print("All required packages found.")
EOF

# ---------------------------------------------------------------------------

# Run the anonymization pipeline against the analyze phase's results
python anonymize_pipeline.py \
    --input_dir "$INPUT_DIR" \
    --pii_results_csv "$PII_RESULTS_CSV" \
    --output_dir "$OUTPUT_DIR" \
    --num_procs "$SLURM_CPUS_PER_TASK" \
    --job_id "$SLURM_JOB_ID" \
    "${KEEP_OPTION[@]}"

echo "Job finished successfully at: $(date)"
